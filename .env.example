# --- Integration mode: demo (sample data + mock applicant API) | production (real adapters required) ---
INTEGRATION_MODE=demo

# --- LLM provider (server-side only; never exposed to the browser) ---
# Testing: OpenRouter. Final target: openai (switch by config only).
LLM_PROVIDER=openrouter
LLM_API_KEY=
# Decisions model (typed answers; app auto-uses AGENT_MODE=decisions):
LLM_MODEL=perplexity/pplx-decider-flash-v1.3:free
# Or a chat model WITH tool calling (AGENT_MODE=tools), e.g. openai/gpt-4o-mini
# AGENT_MODE=decisions   # optional explicit override: decisions | tools
# LLM_BASE_URL=            # optional override
# LLM_TIMEOUT_S=45

# --- Sessions ---
# Required in production mode. Use a long random string.
SESSION_SECRET=

# --- Branding / misc ---
UNIVERSITY_NAME=CHRIST (Deemed to be University)
APP_URL=http://localhost:8000

# Per-IP chat requests per minute (raise if many users share one network)
CHAT_RATE_LIMIT_PER_MIN=20

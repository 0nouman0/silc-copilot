# --- LLM provider (server-side only; never exposed to the browser) ---
# Testing: OpenRouter. Final target: openai (switch by config only).
LLM_PROVIDER=openrouter
LLM_API_KEY=
# Decisions model (typed answers; app auto-uses AGENT_MODE=decisions):
LLM_MODEL=perplexity/pplx-decider-flash-v1.3:free
# Or a chat model WITH tool calling (AGENT_MODE=tools), e.g. openai/gpt-4o-mini
# Optional: a different chat model per agent (tools mode). Both fall back to LLM_MODEL.
# LLM_MODEL_RECOMMEND=openai/gpt-4o-mini   # the recommender benefits from a stronger model
# LLM_MODEL_INFO=openai/gpt-4o-mini
# AGENT_MODE=decisions   # optional explicit override: decisions | tools
# LLM_BASE_URL=            # optional override
# LLM_TIMEOUT_S=45

# --- Data source: CHRIST programme database (the only source of programme facts; no scraped data) ---
CATALOGUE_SOURCE=mysql            # mysql | api | none
APPLICANT_DB_HOST=127.0.0.1
APPLICANT_DB_PORT=3306
APPLICANT_DB_NAME=applicant
AGENT_DB_USER=agent_ro            # SELECT-only account (see docs/ARCHITECTURE.md)
AGENT_DB_PASSWORD=
# CATALOGUE_API_URL=              # when CATALOGUE_SOURCE=api
# CATALOGUE_API_TOKEN=

# --- Branding / misc ---
UNIVERSITY_NAME=CHRIST (Deemed to be University)
APP_URL=http://localhost:8000

# Per-IP chat requests per minute (raise if many users share one network)
CHAT_RATE_LIMIT_PER_MIN=20

# --- Catalog (blueprint) ---
# CATALOGUE_SOURCE=catalog        # catalog (in-memory, default) | mysql (legacy per-request SQL) | api | none
# CATALOG_CHECK_MINUTES=5         # safety-net checksum check; 0 disables
# CATALOG_SNAPSHOT=data/catalog_snapshot.jsonl   # optional JSONL snapshot written after every swap
# UNDERSTANDING_MODE=auto         # auto (ask the AI interpreter only when the local one is unsure) | llm (always) | local (never)
# UNDERSTANDING_MODELS=            # comma-separated chat models for the interpreter (default: the COMPOSE_MODELS list)
# FEES_SOURCE=database            # database (default: stored fee structures) | none
# ADMIN_TOKEN=                    # enables POST /admin/catalog/refresh (X-Admin-Token header); unset = endpoint disabled
# DOCUMENTS_DIR=data/documents    # PDF pipeline cache (python -m app.documents.build)
